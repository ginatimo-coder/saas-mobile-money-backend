import { Controller, Get, Post, Body, Param } from '@nestjs/common';
import { TransactionsService } from './transactions.service';
import { Transaction, TransactionStatus } from './entities/transaction.entity';

@Controller('transactions')
export class TransactionsController {
  constructor(private readonly transactionsService: TransactionsService) {}

  // Effectuer un dépôt (Cash-in)
  @Post('deposit')
  async deposit(
    @Body() body: { userId: string; amount: number; phoneNumber: string; currency?: string },
  ): Promise<Transaction> {
    return await this.transactionsService.createDeposit(
      body.userId,
      body.amount,
      body.phoneNumber,
      body.currency,
    );
  }

  // Effectuer un retrait (Cash-out)
  @Post('withdrawal')
  async withdrawal(
    @Body() body: { userId: string; amount: number; phoneNumber: string; currency?: string },
  ): Promise<Transaction> {
    return await this.transactionsService.createWithdrawal(
      body.userId,
      body.amount,
      body.phoneNumber,
      body.currency,
    );
  }

  // Recevoir la notification de l'opérateur Mobile Money (Webhook)
  @Post('webhook/callback')
  async handleWebhook(
    @Body() body: { reference: string; status: 'SUCCESS' | 'FAILED'; providerReference: string },
  ) {
    const mappedStatus =
      body.status === 'SUCCESS' ? TransactionStatus.SUCCESS : TransactionStatus.FAILED;

    const updatedTransaction = await this.transactionsService.handleProviderWebhook(
      body.reference,
      mappedStatus,
      body.providerReference,
    );

    return {
      received: true,
      message: 'Webhook traité avec succès',
      transaction: updatedTransaction,
    };
  }

  // Consulter l'historique des transactions d'un utilisateur
  @Get('user/:userId')
  async getUserTransactions(@Param('userId') userId: string): Promise<Transaction[]> {
    return await this.transactionsService.findAllByUserId(userId);
  }
}
